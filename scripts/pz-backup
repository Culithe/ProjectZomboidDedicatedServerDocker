#!/bin/bash
# pz-backup: Create a timestamped backup of the current Project Zomboid world
BACKUP_DIR="/home/steam/Zomboid/Backups"
CONSOLE_PIPE="/tmp/pz_console"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="${BACKUP_DIR}/pz_backup_${TIMESTAMP}.tar.gz"

mkdir -p "$BACKUP_DIR"

echo "[PZ Backup] Sending save command to game server..."
if [ -p "$CONSOLE_PIPE" ]; then
    echo "save" > "$CONSOLE_PIPE" 2>/dev/null || true
    sleep 2
fi

echo "[PZ Backup] Compressing saves, database, and configurations..."
cd /home/steam/Zomboid

TARGETS=""
for dir in Saves Server db; do
    if [ -d "$dir" ]; then
        TARGETS="$TARGETS $dir"
    fi
done

if [ -z "$TARGETS" ]; then
    echo "[PZ Backup] Notice: No world data or server files found yet in /home/steam/Zomboid. Skipping archive."
    exit 0
fi

tar -czf "$BACKUP_FILE" $TARGETS

echo "[PZ Backup] Successfully created: ${BACKUP_FILE}"
echo "[PZ Backup] Accessible on host at: ./data/server/Backups/pz_backup_${TIMESTAMP}.tar.gz"
