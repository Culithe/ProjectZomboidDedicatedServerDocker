# ==============================================================================
# PROJECT ZOMBOID DEDICATED SERVER CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS & PASSWORDS
# ------------------------------------------------------------------------------
# Server profile name (affects world save folder and config name)
SERVER_NAME=pzserver

# Password for the built-in 'admin' account (created on first run)
ADMIN_PASSWORD=ChangeMe123!

# Server join password (leave blank for no password)
SERVER_PASSWORD=

# Server name shown in the public server browser
SERVER_PUBLIC_NAME=My Project Zomboid Server

# Server description shown in the server browser
SERVER_PUBLIC_DESC=Hosted via Docker

# Message broadcast to players when they join the server
SERVER_WELCOME_MESSAGE=Welcome to the apocalypse!

# ------------------------------------------------------------------------------
# 2. STEAM UPDATES & BRANCH CONTROL
# ------------------------------------------------------------------------------
# Automatically check for & download updates every time the container starts
AUTO_UPDATE=true

# Steam branch to use. Options:
# - 'public'   : Stable release (Build 41)
# - 'b42_beta' : Experimental Build 42 (when available via Steam)
# - 'unstable' : Public unstable branch
STEAM_BRANCH=public

# Password for private Steam beta branches (leave blank for public branches)
STEAM_BRANCH_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MEMORY ALLOCATION (RAM)
# ------------------------------------------------------------------------------
# Minimum initial RAM allocated to Java Virtual Machine (e.g., 2g, 4g)
SERVER_RAM_MIN=4g

# Maximum RAM allocated to Java Virtual Machine (e.g., 6g, 8g, 12g, 16g)
# Adjust depending on host capacity, player count, and number of mods installed.
SERVER_RAM_MAX=8g

# ------------------------------------------------------------------------------
# 4. NETWORK & PORTS
# ------------------------------------------------------------------------------
# Primary game connection port (UDP) - Must be forwarded on your router
SERVER_PORT=16261

# Steam query port (UDP) - Must be forwarded on your router
STEAM_PORT=16262

# RCON remote administration port (TCP)
RCON_PORT=27015

# Password required to execute remote RCON commands (leave blank to disable RCON)
RCON_PASSWORD=ChangeMeRCON123!

# List server publicly on the in-game server browser (true / false)
PUBLIC=true

# Universal Plug and Play (leave false when hosting in Docker)
UPNP=false

# Prevent multiple connections from the same IP address (true / false)
DENY_SAME_IP=true

# ------------------------------------------------------------------------------
# 5. PLAYERS & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Maximum simultaneous players
MAX_PLAYERS=16

# Maximum allowed client ping in milliseconds before kicking (0 to disable)
PING_LIMIT=400

# Open server (true = anyone can connect; false = whitelist required)
OPEN=true

# Automatically whitelist new players when they enter a username & password on join
AUTO_CREATE_USER_IN_WHITELIST=true

# Remove dead players from the whitelist (hardcore mode)
DROP_OFF_WHITELIST_AFTER_DEATH=false

# ------------------------------------------------------------------------------
# 6. GAMEPLAY RULES & WORLD
# ------------------------------------------------------------------------------
# Player-versus-Player combat enabled (true / false)
PVP=true

# Pause world simulation and time when 0 players are connected (true / false)
PAUSE_EMPTY=true

# Global chat channel enabled (true / false)
GLOBAL_CHAT=true

# Allow players to sleep (true / false)
SLEEP_ALLOWED=false

# Require characters to sleep (true / false)
SLEEP_NEEDED=false

# Safety system (prevents accidental friendly fire)
SAFETY_SYSTEM=true
SHOW_SAFETY=true
SAFETY_TOGGLE_TIMER=2
SAFETY_COOLDOWN_TIMER=120

# Vehicle maximum speed limit (in MPH/KPH depending on client setting)
SPEED_LIMIT=70.0

# Hours until loot respawns in containers (0 = disabled)
HOURS_FOR_LOOT_RESPAWN=0

# Time in minutes taken to read one book page
MINUTES_PER_PAGE=1.0

# Interval in minutes between automatic world saves to disk
SAVE_WORLD_EVERY_MINUTES=15

# When right-clicking trash cans, delete all items (true / false)
TRASH_DELETE_ALL=false

# World Map (default is standard Kentucky map)
MAP=Muldraugh, KY

# Forced spawn coordinates (X,Y,Z). Set to 0,0,0 to let players pick spawn town
SPAWN_POINT=0,0,0

# ------------------------------------------------------------------------------
# 7. STEAM WORKSHOP & MODS
# ------------------------------------------------------------------------------
# Semicolon-separated list of Steam Workshop Item IDs
# Example: WORKSHOP_IDS=2392709985;2688809240
WORKSHOP_IDS=

# Semicolon-separated list of Mod IDs matching the workshop items above
# Example: MOD_NAMES=Arsenal(26)GunFighter;Brita;
MOD_NAMES=

# Enable Steam VAC anti-cheat (true / false)
STEAM_VAC=true

# Verify client Lua checksums against server (prevents client modified scripts)
DO_LUA_CHECKSUM=true

# Show Steam player profiles in scoreboard
STEAM_SCOREBOARD=true

# ------------------------------------------------------------------------------
# 8. IN-GAME VOICE (VOIP)
# ------------------------------------------------------------------------------
VOICE_ENABLE=true
VOICE_3D=true
VOICE_MIN_DISTANCE=10.0
VOICE_MAX_DISTANCE=30.0
